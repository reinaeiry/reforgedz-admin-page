# Backend (Node) configuration
PORT=3000
DATA_DIR=data

# Ingest authentication mapping: "serverId=serverKey,serverId2=serverKey2"
# Your current dev server key:
INGEST_KEYS=reforgedz-dev-eu-1=reforgedz-dev-eu-1-secret

# ─── SSO (auth.reforgedz.net) ──────────────────────────────────────────────
AUTH_BASE=https://auth.reforgedz.net
AUTH_PUBLIC_KEY_URL=https://auth.reforgedz.net/api/auth/public-key
# Or pin the public key inline for cold-boot resilience:
# AUTH_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----...
COOKIE_NAME=rz_session

# ─── BattleMetrics ─────────────────────────────────────────────────────────
# JWT API token from https://battlemetrics.com/developers/personal-access-tokens
BATTLEMETRICS_API_KEY=
# Our organization ID — see https://www.battlemetrics.com/rcon/orgs
BATTLEMETRICS_ORG_ID=112993
# Shared HMAC secret for BM webhook signature verification (generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Then configure BM dashboard webhook with this secret + URL
# https://admin.reforgedz.net/api/bm/webhook
BM_WEBHOOK_SECRET=

# ─── Audit (cross-service mirror to auth) ──────────────────────────────────
# Shared bearer key with reforgedz-auth's /api/internal/audit endpoint.
INTERNAL_AUDIT_KEY=

# ─── Ticket-Bot (Discord<->GUID linkage + transcripts cross-link) ──────────
TICKET_BOT_API_BASE=https://transcripts.reforgedz.net
TICKET_BOT_INTERNAL_KEY=
