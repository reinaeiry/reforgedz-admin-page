{
  "name": "reforgedz-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),d='node_modules/.bin';if(fs.existsSync(d))for(const f of fs.readdirSync(d)){try{fs.chmodSync(p.join(d,f),0o755)}catch{}}\" && npm run build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.76",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "gifenc": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "ssh2": "^1.17.0",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.161.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
